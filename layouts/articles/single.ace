= content nav
  {{ partial "nav" . }}
= content main
  article
    header
      {{ partial "breadcrumps" . }}
      h1.font-sans.text-4xl.text-black.font-bold.mb-4.mt-6
        {{.Title}}
    .font-sans.text-lg.text-grey-darkest.leading-normal.prose
      {{.Content}}
    {{ if $.Param "notebook" }}
      {{ partial "observable" . }}
    {{ end  }}

    .mt-16
      h4 {{ i18n "favorite-articles" . }}
      {{ partial "articles" (dict "context" . "type" "frontpage" "limit" 5)}}

    {{ if in .Params.p_resource "opendata" }}
      {{ partial "newsletter.html" . }}
    {{end}}

= content footer
  {{ partial "footer" . }}
